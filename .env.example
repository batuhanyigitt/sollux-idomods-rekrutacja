# Configure the following only in your hosting provider environment settings.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=SET_A_UNIQUE_PASSWORD_WITH_12_OR_MORE_CHARACTERS
CMS_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_32_OR_MORE_CHARACTERS

# OPTIONAL, DEMO-ONLY: set to true to allow a password shorter than 12 characters.
# DO NOT use this on an unprotected public site: anyone guessing the password can edit/publish content.
# CMS_ALLOW_WEAK_DEMO_PASSWORD=true
